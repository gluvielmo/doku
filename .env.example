# Cloud sync (optional — without these the app saves to this device only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Photo scanning (server-side only)
ANTHROPIC_API_KEY=

# Optional: scans per signed-in user per day (default 5)
SCAN_DAILY_LIMIT=
# Optional: comma-separated emails with no daily scan limit (e.g. yours)
UNLIMITED_EMAILS=

# Optional: shown on the privacy page and used for the feedback link
NEXT_PUBLIC_CONTACT_EMAIL=
